# Host API (browser → local supervisor)
NEXT_PUBLIC_HOST_URL=http://localhost:8787

# Privy (required — desk login)
NEXT_PUBLIC_PRIVY_APP_ID=
# Key quorum id for host session signer (Authorization keys → quorum id)
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Optional: sandbox | production (default). Used by wallet Add funds fiat onramp.
# NEXT_PUBLIC_PRIVY_FUNDING_ENV=sandbox
