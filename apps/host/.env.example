# Host supervisor
PORT=8787
HOST=0.0.0.0

# dsh / OpenRouter (required for /v1/dsh/smoke)
OPENROUTER_API_KEY=
DSH_PROVIDER=openrouter
DSH_MODEL=deepseek/deepseek-v4-flash

# Privy (create app, then fill in)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Tenderly
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Local SQLite path (created at runtime later)
DATABASE_PATH=./data/squadrons.db
