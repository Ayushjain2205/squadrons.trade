# Host supervisor
PORT=8787
HOST=0.0.0.0

# OpenRouter (required for agent chat). Safe in .env.
OPENROUTER_API_KEY=

# Do NOT put DSH_PROVIDER / DSH_MODEL / DSH_HOME in this file.
# dsh refuses those in .env (launching-environment only).
# Host defaults: openrouter + deepseek/deepseek-v4-flash (override by exporting
# DSH_PROVIDER / DSH_MODEL in your shell if needed).

# Privy (required — verify access tokens)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional fallback if a user has no wallet yet (smoke / tooling)
SQUADRONS_DEMO_WALLET=
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Host sets SQUADRONS_AGENT_CHAIN_ID and SQUADRONS_USER_WALLET per dsh turn.

# Tenderly
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Local SQLite path (created at runtime later)
DATABASE_PATH=./data/squadrons.db
